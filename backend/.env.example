# Modelo do arquivo backend/.env  (copie para .env e preencha)
# NUNCA coloque senhas reais neste arquivo de exemplo: ele vai para o Git.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saude_em_dia

JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# ---------------------------------------------------------------------
# E-mail (usado para enviar o código do "Esqueci minha senha").
# É OPCIONAL. Sem SMTP_HOST, a API não envia e-mail: escreve o código no
# terminal onde ela está rodando (modo desenvolvimento).
#
# Exemplo com Gmail (use uma "Senha de app", não a senha da conta):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=seuemail@gmail.com
#   SMTP_PASS=senha_de_app_de_16_letras
#   SMTP_FROM=Saúde em Dia <seuemail@gmail.com>
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
