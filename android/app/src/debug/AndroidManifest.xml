<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- SOMENTE NO MODO DE DESENVOLVIMENTO (debug): permite falar com a API
         local por http:// (sem HTTPS), como http://10.0.2.2:3000.
         O Android bloqueia isso por padrão. Este arquivo não entra na versão
         final (release); a API publicada deve usar https://. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
